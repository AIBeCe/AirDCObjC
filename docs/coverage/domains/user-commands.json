        "class UserCommand : public Flags {",
        "typedef vector<UserCommand> List;",
        "enum {",
        "TYPE_SEPARATOR,",
        "TYPE_RAW,",
        "TYPE_RAW_ONCE,",
        "TYPE_REMOVE,",
        "TYPE_CHAT,",
        "TYPE_CHAT_ONCE,",
        "TYPE_CLEAR = 255\t\t// In a momentary lapse of reason, 255 was chosen in the nmdc version of usercommand for clearing them all",
        "enum {",
        "CONTEXT_HUB = 0x01,",
        "CONTEXT_USER = 0x02,",
        "CONTEXT_SEARCH = 0x04,",
        "CONTEXT_FILELIST = 0x08,",
        "CONTEXT_MASK = CONTEXT_HUB | CONTEXT_USER | CONTEXT_SEARCH | CONTEXT_FILELIST",
        "enum {",
        "FLAG_NOSAVE = 0x01",
        "UserCommand& operator=(const UserCommand& rhs) {\n\t\tcid = rhs.cid; type = rhs.type; ctx = rhs.ctx;\n\t\tname = rhs.name; command = rhs.command; to = rhs.to; hub = rhs.hub;\n\t\t*((Flags*)this) = rhs;\n\t\tdisplayName.clear();\n\t\tsetDisplayName();\n\t\treturn *this;\n\t}",
        "inline bool isRaw() const {\n\t\treturn type == TYPE_RAW || type == TYPE_RAW_ONCE;\n\t}",
        "inline bool isChat() const {\n\t\treturn type == TYPE_CHAT || type == TYPE_CHAT_ONCE;\n\t}",
        "inline bool once() const {\n\t\treturn type == TYPE_RAW_ONCE || type == TYPE_CHAT_ONCE;\n\t}",
        "static bool adc(const string& h);",
        "inline bool adc() const { return adc(hub); }",
        "const StringList& getDisplayName() const;",
        "void setDisplayName();",
        "GETSET(int, cid, Id);",
        "GETSET(int, type, Type);",
        "GETSET(int, ctx, Ctx);",
        "GETSET(string, name, Name);",
        "GETSET(string, command, Command);",
        "GETSET(string, to, To);",
        "GETSET(string, hub, Hub);",
        "StringList displayName;",
        "GETSET(int, cid, Id);",
        "GETSET(int, type, Type);",
        "GETSET(int, ctx, Ctx);",
        "GETSET(string, name, Name);",
        "GETSET(string, command, Command);",
        "GETSET(string, to, To);",
        "GETSET(string, hub, Hub);",
        "\tUserCommand() : cid(0), type(0), ctx(0) { }",
        "\tUserCommand(int aId, int aType, int aCtx, Flags::MaskType aFlags, const string& aName, const string& aCommand, const string& aTo, const string& aHub) noexcept\n\t\t: Flags(aFlags), cid(aId), type(aType), ctx(aCtx), name(aName), command(aCommand), to(aTo), hub(aHub) \n\t{ \n\t\tsetDisplayName();\n\t}",
